*.iml
.gradle
/local.properties
/.idea/
.DS_Store
.env
.env.*
/build
# Every module's build dir, not just the root and app/. Gradle writes a
# per-module `/build` .gitignore (see app/.gitignore), so a NEW module starts
# life with its build output untracked by nothing - `desktop/` was one
# `git add -A` away from committing .class files, kspCaches and test-result
# binaries into a public repo. One line here covers every module, including
# ones that don't exist yet.
build/
/captures
.externalNativeBuild
.cxx
local.properties
.kotlin/

# Built artifacts are distributed via GitHub Releases, never committed.
/app/release/
*.apk
*.aab

# Release signing (never commit)
keystore.properties
*.jks
*.keystore

# Local working notes - deliberately untracked. Listed here so a `git add -A`
# (e.g. during a history squash) can't sweep them into the repo.
CLAUDE.md
RELEASE_GUIDE.md
/project-docs/
.superpowers/
.gstack/
/AGENTS.md
