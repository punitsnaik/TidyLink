<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules (API 31+). The llm_providers prefs hold the user's
   LLM API keys, encrypted with a hardware-backed Android Keystore key (see
   KeyStoreCrypto). Exclude them from cloud backup and device-to-device
   transfer anyway: the Keystore key is non-exportable and never leaves this
   device, so restored ciphertext could never be decrypted (LlmProviderStore
   .load() would catch the failure and reset to an empty list). Backing it up
   would ship the user's key material off-device for zero benefit. Excluded,
   the user re-enters their keys on the new device — same end state, nothing
   leaves. Links themselves remain backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="llm_providers.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="llm_providers.xml" />
    </device-transfer>
</data-extraction-rules>
