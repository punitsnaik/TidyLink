    <!-- First-run intro -->
    <string name="intro_welcome_title">A tidy home for every link</string>
    <string name="intro_welcome_body">TidyLink collects the URLs you save all day and turns them into a searchable library. Everything stays on your device — no account, no backend, no analytics.</string>
    <string name="intro_share_title">Share to save</string>
    <string name="intro_share_body">Share a URL from any app — YouTube, Instagram, X, your browser — and pick TidyLink. It\'s saved before the share sheet closes. You can also add links by hand, or import a text file full of them.</string>
    <string name="intro_organize_title">Find it again</string>
    <string name="intro_organize_body">Every link gets its title, description, and thumbnail fetched in the background. Search across everything, or filter by category with a tap.</string>
    <string name="intro_ai_title">Add AI categorization</string>
    <string name="intro_ai_body">Optionally, an AI provider can give each link a category, tags, and a one-line summary. It uses your own API key — Gemini\'s free tier works. Keys are encrypted and never leave this device.</string>
    <string name="intro_ai_add_key">Add a key</string>
    <string name="intro_ai_configured">AI categorization is ready.</string>
    <string name="intro_action_skip">Skip</string>
    <string name="intro_action_next">Next</string>
    <string name="intro_action_done">Get started</string>

